{
  "permissions": {
    "deny": [
      "Bash(rm:*)",
      "Bash(shred:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
